# ShellCheck configuration
# https://www.shellcheck.net/wiki/

# Default shell dialect
shell=bash

# Disable specific rules:
# SC1091 - Not following sourced files (can't resolve paths)
# SC1090 - Non-constant source paths (e.g. ~/.config/bash/rc, resolved at runtime)
# SC2034 - Variable appears unused (common in sourced configs)
disable=SC1090,SC1091,SC2034
