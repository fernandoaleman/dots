#!/usr/bin/env bash
#
# claude-migrate-projects: copy Claude Code's per-folder project data
# (~/.claude/projects/-Users-me-code-repo) to one name per project that every
# machine shares (~/.claude/projects/repo), for sessions and memory that sync
# across machines. Without --apply it prints the plan and writes nothing.
#
# Usage: claude-migrate-projects [--from DIR|BACKUP.tar.gz] [--host SSH_HOST]
#                                [--machine NAME] [--to DIR] [--apply]
#   --from     a .claude folder, or a backup holding one (default ~/.claude)
#   --host     where the sessions were made, to look up each folder's git
#              remote over ssh (read-only); default this machine
#   --machine  label for memory staged for a merge (default --host or this
#              machine's short hostname)
#   --to       the projects folder to copy into (default ~/.claude/projects)
#   --apply    copy, after backing up --to into ~/claude-migration
#
# Copies only: old folders stay as they are. Re-running is safe: a session
# already copied is skipped, or brought up to date if it has grown since; a
# copy that differs otherwise is left alone and reported. A folder's memory
# is copied to memory/ when it's the project's only memory, and kept up to
# date on re-runs (newer files win, none deleted); memory from more folders
# goes to memory-from-<machine>-<old folder>/ to merge by hand.
#
# Naming is claude-project-name's, as the claude wrapper uses: the repo name
# from the folder's git remote, else the repo's or folder's own name (home is
# "home"). Different repos or folders that end up with one name, and folders
# that no longer exist, are flagged for your call; set their name in
# ~/.config/dots/claude-projects, one "<path glob> <name>" per line, where
# the glob matches the folder's path on --host with ~ for its home (or the
# old folder name when the path is unknown) and the name "-" leaves the
# folder out.
set -euo pipefail
shopt -s nullglob

# shellcheck source=claude-project-name
source "$(dirname "$(readlink -f "$0")")/claude-project-name"
LOCAL_PROJECTS=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects

usage() { sed -n '3,32p' "$0" | sed 's/^# \{0,1\}//'; }
die() { echo "claude-migrate-projects: $*" >&2; exit 1; }

from=$HOME/.claude host="" machine="" apply=""
BACKUP_DIR=$HOME/claude-migration
while (($#)); do
  case $1 in
  --from) from=${2:?--from needs a value}; shift 2 ;;
  --host) host=${2:?--host needs a value}; shift 2 ;;
  --machine) machine=${2:?--machine needs a value}; shift 2 ;;
  --to) LOCAL_PROJECTS=${2:?--to needs a value}; shift 2 ;;
  --apply) apply=1; shift ;;
  -h | --help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
  esac
done
machine=${machine:-${host:-$(hostname -s)}}

# Claude Code names a project folder after its path, every character other
# than A-Z a-z 0-9 replaced by "-".
encode() { local LC_ALL=C; printf '%s' "${1//[^A-Za-z0-9]/-}"; }

# ── Source: a .claude folder, or the projects in a backup ──────────────
if [[ -f $from ]]; then
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  # macOS tar stores metadata as ._ files and xattr headers GNU tar warns about.
  quiet=()
  tar --version 2>/dev/null | grep -q 'GNU tar' && quiet=(--warning=no-unknown-keyword)
  tar -xzf "$from" "${quiet[@]}" --exclude='._*' -C "$tmp" .claude/projects ||
    die "can't unpack .claude/projects from $from"
  src=$tmp/.claude/projects
else
  src=$from/projects
fi
[[ -d $src ]] || die "no projects folder in $from"

# ── Each old folder: sessions, memory files, the folder it was made in ──
folders=() sessions=() memories=() paths=()
for dir in "$src"/*/; do
  dir=${dir%/} folder=${dir##*/}
  jsonl=("$dir"/*.jsonl)
  mem=0
  [[ -d $dir/memory ]] && mem=$(find "$dir/memory" -type f | wc -l)
  # A session's first cwd is where it started; the folder is named after it.
  path=""
  if ((${#jsonl[@]})); then
    while IFS= read -r cwd; do
      if [[ $(encode "$cwd") == "$folder" ]]; then path=$cwd; break; fi
    done < <(grep -h -m1 -o '"cwd":"[^"]*"' "${jsonl[@]}" | sed 's/^"cwd":"//; s/"$//' | sort -u)
  fi
  folders+=("$folder") sessions+=("${#jsonl[@]}") memories+=("$mem") paths+=("$path")
done
((${#folders[@]})) || die "no project folders in $src"

# ── Look up each path and its git remote where the sessions were made ──
# Runs under bash 3.2 too (macOS /bin/bash over ssh). Memory-only folders
# have no session to read a path from, so it searches for a directory whose
# encoded path is the folder name.
resolver() {
  cat <<'EOS'
export LC_ALL=C
enc() { printf '%s' "${1//[^A-Za-z0-9]/-}"; }
decode() {
  local want=$1 cur=$2 child e
  if [ -n "$cur" ] && [ "$(enc "$cur")" = "$want" ]; then printf '%s\n' "$cur"; return 0; fi
  for child in "$cur"/* "$cur"/.[!.]*; do
    [ -d "$child" ] && [ ! -L "$child" ] || continue
    e=$(enc "$child")
    case $want in "$e" | "$e"-*) decode "$want" "$child" && return 0 ;; esac
  done
  return 1
}
printf 'HOME\037%s\n' "$HOME"
while IFS=$'\037' read -r folder path; do
  status=found
  if [ -z "$path" ]; then
    if path=$(decode "$folder" ""); then status=decoded; else
      printf '%s\037\037unresolved\037\n' "$folder"; continue
    fi
  fi
  if [ ! -d "$path" ]; then printf '%s\037%s\037missing\037\n' "$folder" "$path"; continue; fi
  remote="" top=""
  if top=$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    case $top in */.git) top=${top%/.git} ;; *) top=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null) ;; esac
    remote=$(git -C "$path" remote get-url origin 2>/dev/null) ||
      remote=$(git -C "$path" remote get-url "$(git -C "$path" remote | head -n1)" 2>/dev/null) ||
      remote=""
  else
    top=""
  fi
  printf '%s\037%s\037%s\037%s\037%s\n' "$folder" "$path" "$status" "$remote" "$top"
done <<'EOF_DATA'
EOS
  local i
  for i in "${!folders[@]}"; do printf '%s\037%s\n' "${folders[i]}" "${paths[i]}"; done
  echo EOF_DATA
}

if [[ -n $host ]]; then
  resolved=$(resolver | ssh "$host" bash -s) || die "lookup on $host failed"
else
  resolved=$(resolver | bash -s) || die "lookup failed"
fi

declare -A status remote top
src_home=""
while IFS=$'\037' read -r folder path st rem tl; do
  if [[ $folder == HOME ]]; then src_home=$path; continue; fi
  status[$folder]=$st remote[$folder]=$rem top[$folder]=$tl
  for i in "${!folders[@]}"; do
    if [[ ${folders[i]} == "$folder" ]]; then paths[i]=$path; fi
  done
done <<<"$resolved"

tilde() { [[ $1 == "$src_home" || $1 == "$src_home"/* ]] && printf '~%s' "${1#"$src_home"}" || printf '%s' "$1"; }

# ── Name each folder ────────────────────────────────────────────────────
# ids tell apart what shares a name: the remote's owner/repo, or the path.
names=() hows=() calls=() ids=()
for i in "${!folders[@]}"; do
  folder=${folders[i]} path=${paths[i]} st=${status[${folders[i]}]:-unresolved}
  call=""
  if [[ -z $path ]]; then
    if claude_project_override "$folder"; then
      name=$REPLY how=$REPLY_HOW id=override
    else
      name="?" how="" id="" call="can't tell which folder this was"
    fi
  else
    claude_project_name_for "${remote[$folder]:-}" "${top[$folder]:-}" "$path" "$src_home"
    name=$REPLY how=$REPLY_HOW id=$REPLY_ID
    if [[ $st == missing && $id != override ]]; then call="folder no longer exists"; fi
  fi
  [[ $name == - || $name =~ ^[A-Za-z0-9_][A-Za-z0-9_-]{0,63}$ || $name == "?" ]] ||
    call="name \"$name\" isn't 1-64 of A-Z a-z 0-9 _ - (not starting with -)"
  names+=("$name") hows+=("$how") calls+=("$call") ids+=("$id")
done

# ── Plan, and with --apply copy ─────────────────────────────────────────
# What copying session SRC to DEST would do: new, same, grown (DEST is the
# start of SRC: the session went on after an earlier copy) or differs.
session_action() {
  [[ -e $2 ]] || { echo new; return; }
  if cmp -s "$1" "$2"; then echo same; return; fi
  local n
  n=$(wc -c <"$2")
  if (($(wc -c <"$1") > n)) && head -c "$n" "$1" | cmp -s - "$2"; then echo grown; else echo differs; fi
}

# Copy files from memory folder SRC into DEST that are missing there or
# older; prints how many.
sync_memory() {
  local f rel n=0
  while IFS= read -r f; do
    rel=${f#"$1"/}
    if [[ -e $2/$rel ]] && { [[ ! $f -nt $2/$rel ]] || cmp -s "$f" "$2/$rel"; }; then continue; fi
    if [[ $write ]]; then mkdir -p "$(dirname "$2/$rel")" && cp -p "$f" "$2/$rel"; fi
    n=$((n + 1))
  done < <(find "$1" -type f)
  echo "$n"
}

bold=$'\e[1m' dim=$'\e[2m' yellow=$'\e[33m' reset=$'\e[0m'
[[ -t 1 ]] || bold="" dim="" yellow="" reset=""
mapfile -t targets < <(printf '%s\n' "${names[@]}" | sort -u)

# One pass over every project: report, and copy when write is set.
run() {
  local target members i folder dest marker mem_members m action f id n
  local c_new c_grown c_same c_diff
  total_new=0 total_grown=0 total_same=0 total_diff=0 total_mem=0 needs=0
  for target in "${targets[@]}"; do
    members=()
    for i in "${!folders[@]}"; do
      if [[ ${names[i]} == "$target" ]]; then members+=("$i"); fi
    done
    dest=$LOCAL_PROJECTS/$target
    case $target in
    -) echo "${bold}left out${reset} ${dim}(your override)${reset}" ;;
    "?") echo "${bold}${yellow}? no name yet${reset}" ;;
    *)
      if [[ -d $dest ]]; then
        have=("$dest"/*.jsonl) n=0
        [[ -d $dest/memory ]] && n=$(find "$dest/memory" -type f | wc -l)
        echo "${bold}$target${reset} ${dim}(already here: ${#have[@]} sessions, $n memory)${reset}"
      else
        echo "${bold}$target${reset}"
      fi
      ;;
    esac
    declare -A seen=()
    for i in "${members[@]}"; do
      if [[ ${ids[i]} && ${ids[i]} != override ]]; then seen[${ids[i]}]=1; fi
    done
    if [[ $target != [-?] ]] && ((${#seen[@]} > 1)); then
      echo "  ${yellow}needs your call: ${#seen[@]} different repos or folders share this name${reset}"
      needs=$((needs + 1))
    fi
    unset seen

    # Memory: decided from what's there before this run copies anything.
    marker=""
    [[ -r $dest/.migrated-memory-from ]] && marker=$(<"$dest/.migrated-memory-from")
    mem_members=0
    for i in "${members[@]}"; do ((memories[i] == 0)) || mem_members=$((mem_members + 1)); done

    for i in "${members[@]}"; do
      folder=${folders[i]}
      where=$(tilde "${paths[i]}")
      [[ $where ]] || where="path unknown"
      printf '  <- %s\n     %s session%s, %s memory | %s | %s\n' "$folder" "${sessions[i]}" \
        "$( ((sessions[i] == 1)) || echo s)" "${memories[i]}" "$where" "${hows[i]:-no name}"
      if [[ ${calls[i]} ]]; then
        echo "     ${yellow}needs your call: ${calls[i]}${reset}"
        needs=$((needs + 1))
      fi
      [[ $target != [-?] ]] || continue

      c_new=0 c_grown=0 c_same=0 c_diff=0
      for f in "$src/$folder"/*.jsonl; do
        id=${f##*/} id=${id%.jsonl}
        action=$(session_action "$f" "$dest/$id.jsonl")
        case $action in
        new | grown)
          if [[ $write ]]; then
            mkdir -p "$dest"
            cp -p "$f" "$dest/$id.jsonl"
            if [[ -d $src/$folder/$id ]]; then cp -Rp "$src/$folder/$id" "$dest/"; fi
          fi
          ;;&
        new) c_new=$((c_new + 1)) ;;
        grown) c_grown=$((c_grown + 1)) ;;
        same) c_same=$((c_same + 1)) ;;
        differs)
          c_diff=$((c_diff + 1))
          echo "     ${yellow}left alone: session $id differs from the copy here${reset}"
          ;;
        esac
      done
      if ((sessions[i])); then
        echo "     sessions: $c_new new, $c_grown grown since copied, $c_same already here"
      fi
      total_new=$((total_new + c_new)) total_grown=$((total_grown + c_grown))
      total_same=$((total_same + c_same)) total_diff=$((total_diff + c_diff))

      ((memories[i])) || continue
      id=$machine:$folder
      if [[ $marker == "$id" ]]; then
        n=$(sync_memory "$src/$folder/memory" "$dest/memory")
        echo "     memory: $n new or newer files into memory/"
      elif [[ -z $marker && ! -e $dest/memory ]] && ((mem_members == 1)); then
        n=$(sync_memory "$src/$folder/memory" "$dest/memory")
        if [[ $write ]]; then printf '%s\n' "$id" >"$dest/.migrated-memory-from"; fi
        echo "     memory: $n files copied to memory/"
      else
        m=memory-from-$machine-$folder
        n=$(sync_memory "$src/$folder/memory" "$dest/$m")
        echo "     memory: $n files to $m/ (merge into memory/ by hand)"
      fi
      total_mem=$((total_mem + n))
    done
    echo
  done
}

write=""
echo "${bold}Plan for ${#folders[@]} project folders from $from${reset}"
echo "${dim}paths and remotes looked up on ${host:-this machine}; copying into $LOCAL_PROJECTS${reset}"
echo
if [[ $apply ]]; then
  run >/dev/null
  ((needs == 0)) || die "$needs need your call first (run without --apply to see them)"
  if [[ -d $LOCAL_PROJECTS ]]; then
    (umask 077 && mkdir -p "$BACKUP_DIR")
    backup=$BACKUP_DIR/projects-before-migrate-$(date +%Y%m%d-%H%M%S).tar.gz
    (umask 077 && tar -czf "$backup" -C "$(dirname "$LOCAL_PROJECTS")" "$(basename "$LOCAL_PROJECTS")")
    echo "Backed up $LOCAL_PROJECTS to $backup"
    echo
  fi
  if pgrep -x claude >/dev/null; then
    echo "${yellow}Claude is running: open sessions are copied as far as written; re-run after closing it.${reset}"
    echo
  fi
  write=1
fi
run

echo "${bold}Summary${reset}"
echo "  ${#folders[@]} folders -> $(printf '%s\n' "${targets[@]}" | grep -cv '^[-?]$') project names"
echo "  sessions: $total_new new, $total_grown grown, $total_same already here, $total_diff left alone"
echo "  memory files: $total_mem"
if ((needs)); then
  echo "  ${yellow}$needs need your call: set names in $CLAUDE_PROJECTS_OVERRIDES${reset}"
fi
if [[ $write ]]; then echo "  Copied. Old folders are unchanged."; else echo "  Dry run: nothing was written."; fi
