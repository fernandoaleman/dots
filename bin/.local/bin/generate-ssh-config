#!/usr/bin/env bash

print_step() {
  printf "\n\033[1;34m==> %s\033[0m\n" "$1"
}

print_success() {
  printf "\033[1;32m✔ %s\033[0m\n" "$1"
}

print_warning() {
  printf "\033[1;33m⚠ %s\033[0m\n" "$1"
}

print_error() {
  printf "\033[1;31m✖ %s\033[0m\n" "$1"
}


# generate-ssh-config - Generate ~/.ssh/aws and ~/.config/tmux-ssh/tmux-ssh.conf
#                       from EC2 instances across AWS environments
#
# Environments come from ~/.config/generate-ssh-config/environments (installed
# from 1Password by dots), one per line:
#
#   <environment> <aws-profile> <ssh-key> [user, default ubuntu]
#
# Run automatically after aws-role-login, which provides the MFA session the
# role profiles need.

set -e

# =============================================================================
# Dependency Checks
# =============================================================================

if ! command -v aws &>/dev/null; then
  print_error "AWS CLI is not installed. Please install it first."
  exit 1
fi

if ! command -v jq &>/dev/null; then
  print_error "jq is not installed."
  exit 1
fi

# =============================================================================
# Configuration
# =============================================================================

SSH_CONFIG="$HOME/.ssh/aws"
SSH_CONFIG_BAK="$HOME/.ssh/aws.bak"
DEFAULT_SSH_USER="ubuntu"

TMUX_SSH_CONFIG="$HOME/.config/tmux-ssh/tmux-ssh.conf"
TMUX_SSH_CONFIG_BAK="$HOME/.config/tmux-ssh/tmux-ssh.conf.bak"
ENVIRONMENTS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/generate-ssh-config/environments"

declare -A ENV_PROFILES ENV_KEYS ENV_USERS
ENVIRONMENTS=() # in file order

if [[ ! -r $ENVIRONMENTS_FILE ]]; then
  print_error "No environments file: $ENVIRONMENTS_FILE (installed by dots install.sh)"
  exit 1
fi
while read -r env profile key user _; do
  [[ -z $env || $env == \#* ]] && continue
  if [[ -z $profile || -z $key ]]; then
    print_error "Environment '$env' needs an AWS profile and an SSH key ($ENVIRONMENTS_FILE)"
    exit 1
  fi
  ENVIRONMENTS+=("$env")
  ENV_PROFILES["$env"]=$profile
  ENV_KEYS["$env"]=${key/#\~/$HOME}
  ENV_USERS["$env"]=${user:-$DEFAULT_SSH_USER}
done <"$ENVIRONMENTS_FILE"
if ((${#ENVIRONMENTS[@]} == 0)); then
  print_error "No environments in $ENVIRONMENTS_FILE"
  exit 1
fi

# Scratch file accumulating "env<TAB>name-tag<TAB>ssh-host" for every instance,
# used to build the tmux-ssh groups after all environments are processed.
HOST_RECORDS=$(mktemp)
AWS_STDERR=$(mktemp)

# Both outputs are buffered and only moved into place once every environment
# has been queried successfully, so a partial run cannot leave either file
# describing only the environments that happened to answer.
SSH_CONFIG_TMP=$(mktemp "${SSH_CONFIG}.XXXXXX")
TMUX_SSH_CONFIG_TMP=""

trap 'rm -f "$HOST_RECORDS" "$AWS_STDERR" "$SSH_CONFIG_TMP" "$TMUX_SSH_CONFIG_TMP"' EXIT

# Environments whose query errored, as opposed to returning no instances.
failed_envs=()

# =============================================================================
# Generate AWS SSH Hosts
# =============================================================================

print_step "Querying EC2 instances across all environments"

# =============================================================================
# Process Each Environment
# =============================================================================

for env in "${ENVIRONMENTS[@]}"; do
  profile="${ENV_PROFILES[$env]}"
  key="${ENV_KEYS[$env]}"
  env_upper="${env^^}"

  print_step "Processing $env_upper environment (profile: $profile)"

  # Add section header
  echo "" >> "$SSH_CONFIG_TMP"
  echo "# === $env_upper ===" >> "$SSH_CONFIG_TMP"

  # Query EC2 instances. Running only: a stopped instance still reports a
  # private IP, so it would generate a host entry and join a tmux-ssh group
  # that cannot accept a connection. Add "stopped" back to Values if you want
  # entries for boxes you intend to start.
  # A failed query must not look like an empty account. Discarding the exit
  # code here would make expired credentials indistinguishable from a torn-down
  # environment: both yield [] and both print "No instances found". Lab really
  # is empty, so emptiness alone cannot be treated as the error.
  # shellcheck disable=SC2016 # backticks are JMESPath literals, not shell
  if ! instances_json=$(aws ec2 describe-instances \
    --profile "$profile" \
    --filters "Name=instance-state-name,Values=running" \
    --query 'Reservations[].Instances[].{Name:Tags[?Key==`Name`].Value|[0],IP:PrivateIpAddress}' \
    --output json 2>"$AWS_STDERR"); then
    print_error "Query FAILED for $env_upper (profile: $profile)"
    sed -n '1,3p' "$AWS_STDERR" | sed 's/^/    /'
    failed_envs+=("$env_upper")
    continue
  fi

  # Genuinely empty, which is a valid state (Lab has no instances).
  if [[ "$instances_json" == "[]" ]] || [[ -z "$instances_json" ]]; then
    print_warning "No instances found for $env_upper"
    continue
  fi

  # Sort by name, then by IP so that the -NN suffixes below stay stable across
  # runs. Instances in an ASG all share one Name tag, and describe-instances
  # does not return them in a consistent order, so sorting on name alone would
  # reshuffle which box answers to e.g. production-web-asg-07 on every run.
  sorted_instances=$(echo "$instances_json" | jq -r 'sort_by(.Name, .IP) | .[] | select(.Name != null and .IP != null) | "\(.Name)\t\(.IP)"')

  if [[ -z "$sorted_instances" ]]; then
    print_warning "No valid instances found for $env_upper"
    continue
  fi

  # Count occurrences of each name for duplicate handling.
  # Reset first: declare -A does not clear an array that already exists, and
  # these are global, so without the unset they would accumulate across
  # environments.
  unset name_counts name_indices
  declare -A name_counts
  declare -A name_indices

  while IFS=$'\t' read -r name ip; do
    if [[ -n "$name" ]] && [[ -n "$ip" ]]; then
      ((name_counts["$name"]++)) || name_counts["$name"]=1
    fi
  done <<< "$sorted_instances"

  # Generate host entries
  while IFS=$'\t' read -r name ip; do
    if [[ -z "$name" ]] || [[ -z "$ip" ]]; then
      continue
    fi

    # Determine the hostname (handle duplicates)
    if [[ ${name_counts["$name"]} -gt 1 ]]; then
      ((name_indices["$name"]++)) || name_indices["$name"]=1
      hostname=$(printf "%s-%02d" "$name" "${name_indices["$name"]}")
    else
      hostname="$name"
    fi

    # Record for tmux-ssh group generation
    printf '%s\t%s\t%s\n' "$env" "$name" "$hostname" >> "$HOST_RECORDS"

    # Write host entry
    cat >> "$SSH_CONFIG_TMP" << EOF

Host $hostname
    HostName $ip
    User ${ENV_USERS[$env]}
    IdentityFile $key
EOF

  done <<< "$sorted_instances"

  instance_count=$(echo "$sorted_instances" | wc -l | tr -d ' ')
  print_success "Added $instance_count instances from $env_upper"
done

# =============================================================================
# Abort Before Writing If Any Query Failed
# =============================================================================
#
# A stale config is recoverable; one silently missing an entire environment is
# not, because nothing about the result says which hosts are absent.

if (( ${#failed_envs[@]} > 0 )); then
  echo ""
  print_error "Aborted: could not query ${failed_envs[*]}"
  print_warning "$SSH_CONFIG and $TMUX_SSH_CONFIG left unchanged."
  print_warning "Refresh credentials and rerun."
  exit 1
fi

# Every query succeeded but nothing is running anywhere. Writing that result
# would replace the SSH config with an empty one, and the two files must move
# together: updating one while leaving the other would leave the groups naming
# hosts the SSH config no longer defines.
if [[ ! -s "$HOST_RECORDS" ]]; then
  echo ""
  print_error "Aborted: every environment answered, but none is running an instance."
  print_warning "$SSH_CONFIG and $TMUX_SSH_CONFIG left unchanged."
  print_warning "If the fleet really is empty, remove them by hand."
  exit 1
fi

# =============================================================================
# Generate tmux-ssh Groups
# =============================================================================
#
# Groups are derived from the EC2 Name tag rather than hand-maintained, so they
# cannot drift when instances are renamed or retired. Only running instances
# are considered, per the query above. Each environment gets:
#
#   [<env>]            every *-asg instance  (all ASG-managed app servers)
#   [<env>-web]        every *-web-asg instance
#   [<env>-cron]       every *-cron-asg instance
#   [<env>-workers]    every *-workers-asg instance
#   [<env>-console]    every *-console instance
#
# Matching is on the Name TAG, not the generated host name: an ASG with two or
# more instances shares one tag, and the loop above appends a -NN suffix to
# disambiguate, so the host name ends in e.g. -asg-01 and would match none of
# the rules below. A group with no members is skipped rather than emitted
# empty, so environments without a cron or workers ASG simply lack that
# section.

print_step "Generating tmux-ssh groups at $TMUX_SSH_CONFIG"
mkdir -p "$(dirname "$TMUX_SSH_CONFIG")"
TMUX_SSH_CONFIG_TMP=$(mktemp "${TMUX_SSH_CONFIG}.XXXXXX")

awk -F'\t' '
  {
    env = $1; name = $2; host = $3

    if (!(env in env_seen)) { env_seen[env] = 1; envs[++ne] = env }

    if (name ~ /-asg$/)         all[env]     = all[env]     host "\n"
    if (name ~ /-web-asg$/)     web[env]     = web[env]     host "\n"
    if (name ~ /-cron-asg$/)    cron[env]    = cron[env]    host "\n"
    if (name ~ /-workers-asg$/) workers[env] = workers[env] host "\n"
    if (name ~ /-console$/)     console[env] = console[env] host "\n"
  }
  END {
    print "# Generated by generate-ssh-config -- do not edit by hand."
    print "# Groups are derived from EC2 Name tags; rerun the script to refresh."
    print ""

    for (i = 1; i <= ne; i++) {
      env = envs[i]
      emit(env,              all[env])
      emit(env "-web",       web[env])
      emit(env "-cron",      cron[env])
      emit(env "-workers",   workers[env])
      emit(env "-console",   console[env])
    }
  }
  function emit(label, hosts) {
    if (hosts == "") return
    printf "[%s]\n%s\n", label, hosts
  }
' "$HOST_RECORDS" > "$TMUX_SSH_CONFIG_TMP"

group_count=$(grep -c '^\[' "$TMUX_SSH_CONFIG_TMP" || true)
print_success "Added $group_count tmux-ssh groups"

# =============================================================================
# Commit Both Files
# =============================================================================
#
# Publishing is ONE operation, not four statements. Three separate review
# findings on this script were the same defect -- a path that updated one file
# and left the other stale -- so the invariant lives in one place rather than
# being re-asserted at each call site.
#
# Order matters: every backup completes before any replacement, so a failure
# while backing up cannot strand a half-updated pair. The remaining window is
# between the two renames, which are same-directory mv calls on files that
# already exist and are writable; if the second still fails, the first is
# rolled back.

# Every command below carries an explicit "|| return 1". errexit is SUPPRESSED
# for the whole body of a function invoked as an if-condition, which this is,
# so a failing cp here would otherwise fall through to the replacement phase
# and cause exactly the half-updated pair this function exists to prevent.
commit_outputs() {
  # Phase 1 -- all backups. Nothing has been replaced yet at this point.
  if [[ -f "$SSH_CONFIG" ]]; then
    cp "$SSH_CONFIG" "$SSH_CONFIG_BAK" || return 1
  fi
  if [[ -f "$TMUX_SSH_CONFIG" ]]; then
    cp "$TMUX_SSH_CONFIG" "$TMUX_SSH_CONFIG_BAK" || return 1
  fi

  # Phase 2 -- replacements.
  local ssh_existed="false"
  if [[ -f "$SSH_CONFIG" ]]; then
    ssh_existed="true"
  fi

  mv "$SSH_CONFIG_TMP" "$SSH_CONFIG" || return 1

  if ! mv "$TMUX_SSH_CONFIG_TMP" "$TMUX_SSH_CONFIG"; then
    print_error "Could not install $TMUX_SSH_CONFIG; rolling back $SSH_CONFIG"
    if [[ "$ssh_existed" == "true" ]]; then
      cp "$SSH_CONFIG_BAK" "$SSH_CONFIG"
    else
      rm -f "$SSH_CONFIG"
    fi
    return 1
  fi
}

if ! commit_outputs; then
  print_error "Aborted: neither config was updated."
  exit 1
fi

echo ""
print_success "AWS SSH hosts generated at $SSH_CONFIG (previous: $SSH_CONFIG_BAK)"
print_success "tmux-ssh groups generated at $TMUX_SSH_CONFIG (previous: $TMUX_SSH_CONFIG_BAK)"
