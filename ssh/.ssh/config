# SSH client config (dots). Omarchy ships no ~/.ssh/config; its system
# defaults (/etc/ssh/ssh_config.d/20-omarchy-keepalive.conf: keepalives every
# 15 s, 10 s connect timeout) still apply, since nothing here overrides them.

# Work hosts, generated by generate-ssh-config (per-host IdentityFile)
Include ~/.ssh/aws
# Machine-local hosts (not committed)
Include ~/.ssh/config.local

# HostNames become Tailscale names once Tailscale is set up (docs/TODO.md)
Host mac-studio
    HostName 10.0.0.100
    User faleman

Host omarchy
    HostName 10.0.0.200
    User faleman

Host *
    # Inside tmux TERM is tmux-256color, which many servers lack; TERM is
    # sent even if the server accepts no other variables
    SetEnv TERM=xterm-256color
    # Add unknown hosts automatically; still refuse changed host keys
    StrictHostKeyChecking accept-new
