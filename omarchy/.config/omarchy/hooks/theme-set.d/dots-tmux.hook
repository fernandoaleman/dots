#!/bin/bash
#
# dots: runs after every theme change (theme slug in $1). Reloads tmux's
# config so its bar follows the theme: a dots theme's tmux.conf (e.g.
# Catppuccin Studio) or, for any other theme, Omarchy's own bar again.
# See docs/decisions/desktop.md.

tmux info &>/dev/null || exit 0
tmux source-file ~/.config/tmux/tmux.conf
