#!/bin/bash
#
# dots: runs after every theme change (theme slug in $1). Reloads tmux's
# config so its bar follows the theme: dots' bar for that theme
# (~/.config/tmux/themes/<slug>.conf, e.g. Moonlight's) or, for any other
# theme, Omarchy's own bar again.
# terminal-overrides/-features go back to tmux's defaults first: Omarchy's
# tmux.conf (and tmux.dots.conf) append to them, so each reload would add
# the same entries again. See docs/decisions/desktop.md.

tmux info &>/dev/null || exit 0
tmux set -su terminal-overrides \; set -su terminal-features \; \
  source-file ~/.config/tmux/tmux.conf
