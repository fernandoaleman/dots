set editing-mode vi

# Emacs-style line movement while in vi insert mode
set keymap vi-insert
"\C-a": beginning-of-line
"\C-e": end-of-line
"\C-k": kill-line

# Show the vi mode in the prompt, only in command (normal) mode: "[vim]"
set show-mode-in-prompt on
set vi-ins-mode-string ""
set vi-cmd-mode-string "\1\e[1;33m\2[vim]\1\e[0m\2 "
