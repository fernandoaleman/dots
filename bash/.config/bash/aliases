# File system
alias ll='lsa'
alias ln='ln -v'
alias mkdir='mkdir -pv'
alias grep='grep --color=auto'

# Print PATH one entry per line
alias path='echo $PATH | tr -s ":" "\n"'

# MariaDB's client is the mysql client on Arch; mysql/mysqldump are deprecated
# names that print a warning (and will be removed). Skipped where there is no
# mariadb (e.g. the Mac's Homebrew mysql-client).
if command -v mariadb &>/dev/null; then
  alias mysql='mariadb'
  alias mysqldump='mariadb-dump'
fi

# Muscle memory: ncdu was dropped for Omarchy's dua (docs/decisions/packages.md)
ncdu() {
  echo "ncdu isn't installed; Omarchy ships dua. Interactive disk usage: dua i ${*:-.}" >&2
  return 127
}

# Git: old zsh 50-aliases kept for muscle memory (re-added 2026-10-19,
# docs/decisions/shell.md); to retire once Omarchy's (g, gcm, gcam, gcad)
# are habit (docs/TODO.md). gs shadows Ghostscript's gs at the prompt only
# (scripts still get it; `command gs` runs it).
alias gs='git status'
alias ggpur='git pull --rebase origin "$(git branch --show-current)"'
alias gftf='git fetch --tags --force'
alias ggpurt='ggpur && gftf'
# Not `git restore --staged --worktree :/`: reset --hard also ends a stuck
# merge or cherry-pick (man git, "Reset, restore and revert").
alias grhh='git reset HEAD --hard'
